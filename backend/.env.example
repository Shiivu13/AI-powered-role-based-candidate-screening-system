# Copy to backend/.env and adjust. Every setting is optional.

# --- LLM -------------------------------------------------------------------
# auto = Gemini when GEMINI_API_KEY is set, otherwise offline (heuristic) mode
LLM_PROVIDER=auto
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.4

# --- Embeddings & retrieval --------------------------------------------------
# lsa (local, default) | gemini | sentence-transformers
# Changing the provider requires re-running: python -m scripts.ingest_kb
EMBEDDING_PROVIDER=lsa
EMBEDDING_DIM=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4
MMR_LAMBDA=0.9
BM25_WEIGHT=0.5

# --- Storage -----------------------------------------------------------------
# DATA_DIR=./data
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/screening

# --- Interview -----------------------------------------------------------------
DEFAULT_NUM_QUESTIONS=6
MAX_FOLLOW_UPS=2

# --- API -----------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
LOG_LEVEL=INFO
